{
  "name": "@mixum/map",
  "version": "0.1.0",
  "description": "Mixum Agent Protocol (MAP) client SDK — TypeScript",
  "license": "Apache-2.0",
  "repository": "github:ashreo/Mixum-Agent-Protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test test/sdk.test.mjs test/schema.test.mjs",
    "test:e2e": "node test/e2e-agentd.mjs",
    "test:legacy": "node test/legacy-e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
